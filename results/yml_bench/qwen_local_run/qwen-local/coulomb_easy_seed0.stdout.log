from scipy.integrate import solve_ivp
import numpy as np

def discovered_law(pos1, pos2, p1, p2, velocity2, duration, **params):
    """
    Two-particle system in 2D with attractive central force.
    Particle 1 has charge +p1, particle 2 has charge -p2 (opposite charges).
    The force magnitude scales as p1*p2/r^alpha where r is separation.
    The force is always attractive (directed toward particle 1).
    """
    k = params.get("k", 0.3)
    alpha = params.get("alpha", 1.0)
    
    r0 = np.array(pos2, dtype=np.float64) - np.array(pos1, dtype=np.float64)
    v0 = np.array(velocity2, dtype=np.float64)
    y0 = np.concatenate([r0, v0])
    
    def rhs(t, y):
        r = y[:2]
        v = y[2:]
        dist_sq = r[0]**2 + r[1]**2
        dist = np.sqrt(dist_sq)
        if dist < 1e-8:
            dist = 1e-8
            dist_sq = dist**2
        # Acceleration: a = -k * p1 * p2 * r / dist^(alpha + 1)
        # magnitude of acceleration = k * p1 * p2 / dist^alpha
        accel_mag = k * p1 * p2 / (dist ** alpha)
        ax = -accel_mag * r[0] / dist
        ay = -accel_mag * r[1] / dist
        return np.array([v[0], v[1], ax, ay])
    
    sol = solve_ivp(rhs, [0.0, duration], y0, method="RK45", rtol=1e-6, atol=1e-8, max_step=0.1)
    final_r = sol.y[:2, -1]
    final_v = sol.y[2:, -1]
    return final_r.tolist(), final_v.tolist()

def fit_parameters():
    return {
        "k": {"init": 0.3, "bounds": [0.01, 10.0]},
        "alpha": {"init": 1.0, "bounds": [0.1, 3.0]},
    }

