from scipy.integrate import solve_ivp
import numpy as np

def discovered_law(pos1, pos2, p1, p2, velocity2, duration, **params):
    """
    Particle 2 experiences an attractive central force toward particle 1 at the origin.
    The acceleration scales as -G * (p1/p2) * r_hat / r^alpha, where r_hat is the unit
    vector from particle 2 toward particle 1. The exponent alpha and coupling G are fitted.
    """
    G = params.get("G", 0.675)
    alpha = params.get("alpha", 2.54)
    
    def rhs(t, y):
        x, y_pos, vx, vy = y
        r = np.sqrt(x**2 + y_pos**2)
        if r < 1e-10:
            return [vx, vy, 0.0, 0.0]
        ax = -G * p1 / p2 * x / r**(alpha + 1)
        ay = -G * p1 / p2 * y_pos / r**(alpha + 1)
        return [vx, vy, ax, ay]
    
    y0 = [pos2[0], pos2[1], velocity2[0], velocity2[1]]
    sol = solve_ivp(rhs, (0.0, duration), y0, method="RK45", rtol=1e-4, atol=1e-4)
    final_state = sol.y[:, -1]
    return [final_state[0], final_state[1]], [final_state[2], final_state[3]]

def fit_parameters():
    return {
        "G": {"init": 0.675, "bounds": [0.1, 5.0]},
        "alpha": {"init": 2.54, "bounds": [1.0, 4.0]},
    }

