from scipy.integrate import solve_ivp
import numpy as np

def discovered_law(pos1, pos2, p1, p2, velocity2, duration, **params):
    """
    The particle experiences a velocity-dependent force perpendicular to its velocity,
    analogous to a Lorentz force from a uniform magnetic field in the z-direction.
    The coupling strength scales as k * p1 / p2, producing cyclotron motion.
    """
    k = params.get("k", 1.0)
    x0, y0 = pos2
    vx0, vy0 = velocity2
    y0_arr = np.array([x0, y0, vx0, vy0])
    
    def rhs(t, y):
        x, y_pos, vx, vy = y
        coeff = k * p1 / p2
        ax = coeff * vy
        ay = -coeff * vx
        return [vx, vy, ax, ay]
    
    sol = solve_ivp(rhs, (0.0, duration), y0_arr, method="RK45", rtol=1e-4, atol=1e-4)
    final_pos2 = [sol.y[0, -1], sol.y[1, -1]]
    final_vel2 = [sol.y[2, -1], sol.y[3, -1]]
    return final_pos2, final_vel2

def fit_parameters():
    return {
        "k": {"init": 1.0, "bounds": [0.1, 10.0]},
    }

