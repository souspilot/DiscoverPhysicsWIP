from scipy.integrate import solve_ivp
import numpy as np

def discovered_law(pos1, pos2, p1, p2, velocity2, duration, **params):
    """
    Particle 2 experiences an attractive inverse-power central force from particle 1.
    The acceleration is a = -alpha * (p1/p2) * r_hat / r^n, where r is the separation.
    p1 acts as a charge/strength, p2 acts as mass.
    """
    alpha = params.get("alpha", 0.2)
    n = params.get("n", 2.0)
    
    def rhs(t, y):
        x, y_pos, vx, vy = y
        dx = x - pos1[0]
        dy = y_pos - pos1[1]
        r = np.sqrt(dx**2 + dy**2)
        if r < 1e-8:
            r = 1e-8
        # Central force: F = -alpha * (p1/p2) * r_hat / r^n
        # acceleration = F / p2 (but p2 already in denominator)
        # Actually: a = -alpha * p1/p2 * (dx, dy) / r^(n+1)
        factor = -alpha * p1 / p2 / (r ** (n + 1))
        ax = factor * dx
        ay = factor * dy
        return [vx, vy, ax, ay]
    
    y0 = [pos2[0], pos2[1], velocity2[0], velocity2[1]]
    sol = solve_ivp(rhs, (0.0, duration), y0, method="RK45", rtol=1e-4, atol=1e-4,
                    max_step=0.1)
    final_pos2 = sol.y[:2, -1].tolist()
    final_vel2 = sol.y[2:, -1].tolist()
    return final_pos2, final_vel2

def fit_parameters():
    return {
        "alpha": {"init": 0.2, "bounds": [0.01, 10.0]},
        "n": {"init": 2.0, "bounds": [0.5, 5.0]},
    }

