from scipy.integrate import solve_ivp
import numpy as np

def discovered_law(pos1, pos2, p1, p2, velocity2, duration, **params):
    """
    Magnetic-like force law in 2D: a particle experiences acceleration perpendicular to its velocity.
    The field strength depends on the source property p1 and the distance from the source.
    The force is proportional to p1/r^n and acts perpendicular to velocity,
    causing helical/circular motion rather than attraction or repulsion.
    """
    alpha = params.get("alpha", 1.0)
    n = params.get("n", 1.0)
    
    def rhs(t, y):
        x, yp, vx, vy = y
        r = np.sqrt(x**2 + yp**2)
        if r < 1e-10:
            return [vx, vy, 0.0, 0.0]
        # Magnetic-like force: a = alpha * p1 / r^n * (-vy, vx) / |v|
        # Simplified: a = alpha * p1 / r^n * perpendicular_to_v
        B = alpha * p1 / (r**n)
        ax = -B * vy
        ay = B * vx
        return [vx, yp, ax, ay]
    
    y0 = [pos2[0], pos2[1], velocity2[0], velocity2[1]]
    sol = solve_ivp(rhs, (0.0, duration), y0, method="RK45", rtol=1e-4, atol=1e-6, max_step=0.1)
    final_state = sol.y[:, -1]
    return [final_state[0], final_state[1]], [final_state[2], final_state[3]]

def fit_parameters():
    return {
        "alpha": {"init": 0.5, "bounds": [0.01, 10.0]},
        "n": {"init": 1.0, "bounds": [0.0, 4.0]},
    }

