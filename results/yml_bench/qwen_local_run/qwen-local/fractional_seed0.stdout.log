def discovered_law(pos1, pos2, p1, p2, velocity2, duration, **params):
    """
    Particle 2 experiences two forces from particle 1 at the origin:
    (1) An attractive central force scaling as p1/r^n with n≈0.5.
    (2) A velocity-dependent transverse (Lorentz-like) force proportional to B*v_perp.
    The probe's property p2 does not significantly affect the dynamics in the tested range.
    """
    from scipy.integrate import solve_ivp
    import numpy as np
    G = params.get("G", 1.0)
    n = params.get("n", 0.5)
    B = params.get("B", 4.0)
    y0 = [pos2[0], pos2[1], velocity2[0], velocity2[1]]
    def rhs(t, y):
        x, y, vx, vy = y
        r = np.sqrt(x**2 + y**2)
        if r < 1e-10:
            r = 1e-10
        fr = -G * p1 / (r**n)
        fx = fr * x / r + B * vy
        fy = fr * y / r - B * vx
        return [vx, vy, fx, fy]
    sol = solve_ivp(rhs, (0.0, duration), y0, method="RK45", rtol=1e-4, atol=1e-6)
    final_pos2 = [sol.y[0, -1], sol.y[1, -1]]
    final_vel2 = [sol.y[2, -1], sol.y[3, -1]]
    return final_pos2, final_vel2

def fit_parameters():
    return {
        "G": {"init": 1.0, "bounds": [0.1, 10.0]},
        "n": {"init": 0.5, "bounds": [0.1, 2.0]},
        "B": {"init": 4.0, "bounds": [1.0, 10.0]},
    }

