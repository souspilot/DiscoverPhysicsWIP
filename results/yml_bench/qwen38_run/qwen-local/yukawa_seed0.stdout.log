def discovered_law(pos1, pos2, p1, p2, velocity2, duration, **params):
    """
    Particle 2 moves under a static central attractive field generated by the fixed source particle 1 at the origin.
    The force magnitude follows G * p1**alpha / (p2**beta * r**n) and points along the line of sight toward the origin, like a Newtonian gravity law with p1 as source strength, p2 as probe inertial mass, and an inverse-power distance fall-off.
    Newton's second law x'' = a(pos2) is integrated from t = 0 to t = duration to return the final state.
    """
    from scipy.integrate import solve_ivp
    import math
    G = params.get("G", 0.2)
    alpha = params.get("alpha", 1.0)
    beta = params.get("beta", 1.0)
    n = params.get("n", 2.0)
    C = G * (p1 ** alpha) / (p2 ** beta)
    def rhs(t, y):
        px, py = y[0], y[1]
        vx, vy = y[2], y[3]
        r2 = px * px + py * py
        r = math.sqrt(r2) if r2 > 1e-12 else 1e-6
        if r < 1e-3:
            r = 1e-3
        f = -C / (r ** (n + 1))
        return [vx, vy, f * px, f * py]
    y0 = [pos2[0], pos2[1], velocity2[0], velocity2[1]]
    sol = solve_ivp(rhs, (0.0, float(duration)), y0, method="RK45", rtol=1e-5, atol=1e-5)
    xf = sol.y[:, -1]
    return [float(xf[0]), float(xf[1])], [float(xf[2]), float(xf[3])]

def fit_parameters():
    return {
        "G": {"init": 0.2, "bounds": [0.02, 5.0]},
        "alpha": {"init": 1.0, "bounds": [0.2, 2.0]},
        "beta": {"init": 1.0, "bounds": [0.0, 2.0]},
        "n": {"init": 2.0, "bounds": [1.0, 3.5]},
    }

