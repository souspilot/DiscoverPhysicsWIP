def discovered_law(pos1, pos2, p1, p2, velocity2, duration, **params):
    """A fixed source at pos1 attracts the probe with a central inverse-power force.
    The acceleration is a = -k0 * p1**e1 * p2**e2 * rhat / r**p, where r = |pos2 - pos1|.
    The source strength scales with p1 (positive power) and the probe inertia with p2 (negative power)."""
    from scipy.integrate import solve_ivp
    import numpy as np
    k0 = params.get("k0", 1.0)
    e1 = params.get("e1", 1.0)
    e2 = params.get("e2", -1.0)
    p  = params.get("p", 2.0)
    y0 = [pos1[0], pos1[1], pos2[0], pos2[1], velocity2[0], velocity2[1]]
    def rhs(t, y):
        x1, y1, x2, y2, vx, vy = y
        dx = x2 - x1; dy = y2 - y1
        r = (dx*dx + dy*dy)**0.5
        if r < 1e-6: r = 1e-6
        a = -k0 * (p1**e1) * (p2**e2) / (r**p)
        ax = a * dx / r
        ay = a * dy / r
        return [0.0, 0.0, vx, vy, ax, ay]
    sol = solve_ivp(rhs, (0.0, duration), y0, method="RK45", rtol=1e-6, atol=1e-8)
    return [sol.y[2,-1], sol.y[3,-1]], [sol.y[4,-1], sol.y[5,-1]]

def fit_parameters():
    return {
        "k0": {"init": 1.0, "bounds": [0.05, 50.0]},
        "e1": {"init": 1.0, "bounds": [0.0, 3.0]},
        "e2": {"init": -1.0, "bounds": [-3.0, 0.0]},
        "p":  {"init": 2.0, "bounds": [1.0, 4.0]},
    }

