def discovered_law(pos1, pos2, p1, p2, velocity2, duration, **params):
    """Particle 2 feels an attractive central force toward the fixed origin.
    The acceleration is directed along -r_hat with magnitude K * p1**a1 * p2**a2 / r**n,
    an inverse-power pull whose radial exponent n and strength K are fitted to data."""
    from scipy.integrate import solve_ivp
    import numpy as np
    import math
    G  = params.get("G", 1.0)
    n  = params.get("n", 2.0)
    a1 = params.get("a1", 1.0)
    a2 = params.get("a2", 1.0)
    def rhs(t, y):
        x, v0, v1 = y[0], y[1], y[2]
        r = math.hypot(x[0], x[1])
        if r < 1e-6:
            ax = ay = 0.0
        else:
            mag = G * (p1 ** a1) * (p2 ** a2) / (r ** n)
            ax = -mag * x[0] / r
            ay = -mag * x[1] / r
        return [x[0], x[1], v0, v1, ax, ay]
    y0 = [pos2[0], pos2[1], velocity2[0], velocity2[1], 0.0, 0.0]
    sol = solve_ivp(rhs, (0.0, duration), y0, method="RK45", rtol=1e-4, atol=1e-4)
    f = sol.y[:, -1]
    return (f[0], f[1]), (f[3], f[4])
def fit_parameters():
    return {
        "G":  {"init": 1.0, "bounds": [0.01, 10.0]},
        "n":  {"init": 2.0, "bounds": [0.5, 3.0]},
        "a1": {"init": 1.0, "bounds": [0.0, 3.0]},
        "a2": {"init": 1.0, "bounds": [0.0, 3.0]},
    }

